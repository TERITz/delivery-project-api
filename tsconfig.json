{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "./dist",
    "types": ["node"],
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "config/**/*.ts", "controller/**/*.ts", "model/**/*.ts", "service/**/*.ts", "utils/**/*.ts"]
}
